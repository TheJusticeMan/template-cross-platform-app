{
  "name": "template-cross-platform-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform TypeScript application template with ESBuild, Electron, and Capacitor",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "electron:dev": "npm run build && electron electron/main.js",
    "electron:build": "npm run build && electron-builder",
    "cap:init": "cap init",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap copy && cap sync",
    "cap:open:android": "cap open android",
    "web:deploy": "gh-pages -d dist",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "typescript",
    "esbuild",
    "electron",
    "capacitor",
    "cross-platform",
    "template"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.20.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^9.0.0",
    "gh-pages": "^6.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
